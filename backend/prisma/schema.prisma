generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id            Int       @id @default(autoincrement())
  nomeCompleto  String
  email         String    @unique
  senhaHash     String
  role          String    @default("USER")
  ativo         Boolean   @default(true)
  dataCadastro  DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  cursosInstrutor  Curso[]         @relation("InstrutorCursos")
  matriculas       Matricula[]
  progressos       ProgressoAula[]
  avaliacoes       Avaliacao[]
  certificados     Certificado[]
  assinaturas      Assinatura[]
  notificacoes     Notificacao[]

  @@map("usuarios")
}

model Categoria {
  id        Int     @id @default(autoincrement())
  nome      String  @unique
  descricao String

  cursos  Curso[]
  trilhas Trilha[]

  @@map("categorias")
}

model Curso {
  id              Int      @id @default(autoincrement())
  titulo          String
  descricao       String
  instrutorId     Int
  categoriaId     Int
  nivel           String
  dataPublicacao  DateTime @default(now())
  totalAulas      Int      @default(0)
  totalHoras      Float    @default(0)

  instrutor     Usuario      @relation("InstrutorCursos", fields: [instrutorId], references: [id])
  categoria     Categoria    @relation(fields: [categoriaId], references: [id])
  modulos       Modulo[]
  matriculas    Matricula[]
  avaliacoes    Avaliacao[]
  certificados  Certificado[]
  trilhasCursos TrilhaCurso[]
  planosCursos  PlanoCurso[]

  @@map("cursos")
}

model Modulo {
  id       Int    @id @default(autoincrement())
  cursoId  Int
  titulo   String
  ordem    Int

  curso Curso  @relation(fields: [cursoId], references: [id])
  aulas Aula[]

  @@map("modulos")
}

model Aula {
  id              Int    @id @default(autoincrement())
  moduloId        Int
  titulo          String
  tipoConteudo    String
  urlConteudo     String
  duracaoMinutos  Int
  ordem           Int

  modulo     Modulo          @relation(fields: [moduloId], references: [id])
  progressos ProgressoAula[]

  @@map("aulas")
}

model Matricula {
  id             Int       @id @default(autoincrement())
  usuarioId      Int
  cursoId        Int
  dataMatricula  DateTime  @default(now())
  dataConclusao  DateTime?

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  curso   Curso   @relation(fields: [cursoId], references: [id])

  @@map("matriculas")
}

model ProgressoAula {
  id            Int      @id @default(autoincrement())
  usuarioId     Int
  aulaId        Int
  dataConclusao DateTime @default(now())
  status        String

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  aula    Aula    @relation(fields: [aulaId], references: [id])

  @@unique([usuarioId, aulaId])
  @@map("progresso_aulas")
}

model Avaliacao {
  id            Int      @id @default(autoincrement())
  usuarioId     Int
  cursoId       Int
  nota          Int
  comentario    String?
  dataAvaliacao DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  curso   Curso   @relation(fields: [cursoId], references: [id])

  @@map("avaliacoes")
}

model Trilha {
  id          Int    @id @default(autoincrement())
  titulo      String
  descricao   String
  categoriaId Int

  categoria     Categoria     @relation(fields: [categoriaId], references: [id])
  trilhasCursos TrilhaCurso[]
  certificados  Certificado[]

  @@map("trilhas")
}

model TrilhaCurso {
  id       Int @id @default(autoincrement())
  trilhaId Int
  cursoId  Int
  ordem    Int

  trilha Trilha @relation(fields: [trilhaId], references: [id])
  curso  Curso  @relation(fields: [cursoId], references: [id])

  @@unique([trilhaId, cursoId])
  @@map("trilhas_cursos")
}

model Certificado {
  id                Int      @id @default(autoincrement())
  usuarioId         Int
  cursoId           Int
  trilhaId          Int?
  codigoVerificacao String   @unique
  dataEmissao       DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  curso   Curso   @relation(fields: [cursoId], references: [id])
  trilha  Trilha? @relation(fields: [trilhaId], references: [id])

  @@map("certificados")
}

model Plano {
  id            Int    @id @default(autoincrement())
  nome          String
  descricao     String
  preco         Float
  duracaoMeses  Int

  assinaturas  Assinatura[]
  planosCursos PlanoCurso[]

  @@map("planos")
}

model Assinatura {
  id         Int      @id @default(autoincrement())
  usuarioId  Int
  planoId    Int
  dataInicio DateTime @default(now())
  dataFim    DateTime

  usuario    Usuario     @relation(fields: [usuarioId], references: [id])
  plano      Plano       @relation(fields: [planoId], references: [id])
  pagamentos Pagamento[]

  @@map("assinaturas")
}

model Pagamento {
  id                   Int      @id @default(autoincrement())
  assinaturaId         Int
  valorPago            Float
  dataPagamento        DateTime @default(now())
  metodoPagamento      String
  idTransacaoGateway   String

  assinatura Assinatura @relation(fields: [assinaturaId], references: [id])

  @@map("pagamentos")
}

model PlanoCurso {
  planoId Int
  cursoId Int

  plano Plano @relation(fields: [planoId], references: [id], onDelete: Cascade)
  curso Curso @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@id([planoId, cursoId])
  @@map("planos_cursos")
}

model Notificacao {
  id          Int      @id @default(autoincrement())
  usuarioId   Int?
  roleDestino String?  @default("TODOS") // "USER", "ADMIN", "INSTRUTOR", "TODOS"
  titulo      String
  mensagem    String
  tipo        String   // "BOAS_VINDAS", "PAGAMENTO", "MATRICULA", "NOVO_CURSO", "NOVO_MODULO", "NOVA_TRILHA", "CERTIFICADO", "SISTEMA"
  lida        Boolean  @default(false)
  dadosExtras String?
  dataCriacao DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("notificacoes")
}
